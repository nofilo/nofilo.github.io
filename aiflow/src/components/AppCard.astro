---
import { apps } from '../data/catalog';
import ActionLink from './ActionLink.astro';
import StatusBadge from './StatusBadge.astro';
import Card from './Card.astro';
import Icon from './Icon.astro';
import type { AppSummary } from '../data/home';
interface Props { app: AppSummary; featured?: boolean; pending?: boolean; lead?: boolean; }
const { app, featured = false, pending = false, lead = false } = Astro.props;
const platforms = apps.find(item=>app.href === `/aiflow/workspace/apps/${item.id}/`)?.platforms || [];
const availableStatuses = ['已有入口', '可下载'];
const pendingStatuses = ['待开发', '待上线', '适配待确认'];
const tone = app.status ? (availableStatuses.includes(app.status) ? 'available' : pendingStatuses.includes(app.status) ? 'pending' : 'neutral') : 'neutral';
---
<Card class={featured ? (lead ? 'app-card app-card--featured app-card--lead' : 'app-card app-card--featured') : 'app-card'} reveal>
  <div class="app-card__top"><span class="card-symbol card-symbol--app"><Icon name={app.icon} /></span><div class="app-card__meta"><span>{app.category}</span>{app.status && <StatusBadge tone={tone}>{app.status}</StatusBadge>}</div></div>
  <div class="platform-tags">{platforms.map(platform=><span>{platform}</span>)}</div><h3>{app.name}</h3>
  {app.description && <p>{app.description}</p>}
  <ActionLink href={app.href} pending={pending} label={app.name} class="app-card__action"><span>查看应用</span><Icon name="arrow" /></ActionLink>
</Card>
