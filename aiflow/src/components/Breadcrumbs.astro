---
interface Props { items: { label: string; href?: string }[]; }
const { items } = Astro.props;
---
<nav aria-label="面包屑" class="breadcrumbs"><ol>{items.map((item, i) => <li>
  {i > 0 && <span aria-hidden="true" class="breadcrumb-divider">/</span>}
  {item.href && i < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</span>}
</li>)}</ol></nav>
