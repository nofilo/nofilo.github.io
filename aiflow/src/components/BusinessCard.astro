---
import Card from './Card.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { Business } from '../data/home';
interface Props { business: Business; }
const { business } = Astro.props;
---
<Card class="business-card" reveal>
  <div class="business-card__top"><span class="card-symbol"><Icon name={business.icon} /></span><a class="card-open" href={business.href} aria-label={`查看${business.title}`}><Icon name="open" /></a></div>
  <h3>{business.title}</h3>
  <ul class="business-links">{business.links.map(item => <li><a href={item.href}><span>{item.label}</span><Icon name="arrow" class="link-cue" /></a></li>)}</ul>
  <Button href={business.href} label={business.title} class="business-card__button"><span>{business.title === '新人培训' ? '进入新人培训' : `查看${business.title}应用`}</span><Icon name="arrow" /></Button>
</Card>
