---
interface Props {
  href?: string; variant?: 'primary' | 'secondary' | 'text' | 'invert'; pending?: boolean;
  label?: string; class?: string; disabled?: boolean; type?: 'button' | 'submit'; magnetic?: boolean;
}
const { href, variant = 'secondary', pending = false, label, class: className, disabled = false, type = 'button', magnetic = false } = Astro.props;
---
{href && !disabled ? (
  <a href={pending ? '#next-page' : href} data-destination={pending ? href : undefined}
    data-page-label={pending ? label : undefined} data-magnetic={magnetic ? 'true' : undefined} class:list={['button', `button--${variant}`, className]}><slot /></a>
) : (
  <button type={type} disabled={disabled} data-magnetic={magnetic ? 'true' : undefined} class:list={['button', `button--${variant}`, className]}><slot /></button>
)}
