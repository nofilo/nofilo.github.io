---
interface Props {
  id: string; label: string; name?: string; type?: 'text' | 'email' | 'search' | 'textarea' | 'select';
  value?: string; placeholder?: string; hint?: string; error?: string; required?: boolean;
  options?: { label: string; value: string }[];
}
const { id, label, name = id, type = 'text', value, placeholder, hint, error, required = false, options = [] } = Astro.props;
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---
<div class="form-field">
  <label for={id}>{label}{required && <span class="field-required">（必填）</span>}</label>
  {type === 'textarea' ? <textarea id={id} name={name} placeholder={placeholder} required={required} aria-describedby={describedBy} aria-invalid={error ? 'true' : undefined}>{value}</textarea>
  : type === 'select' ? <select id={id} name={name} required={required} aria-describedby={describedBy} aria-invalid={error ? 'true' : undefined}>{options.map(option => <option value={option.value} selected={option.value === value}>{option.label}</option>)}</select>
  : <input id={id} name={name} type={type} value={value} placeholder={placeholder} required={required} aria-describedby={describedBy} aria-invalid={error ? 'true' : undefined} />}
  {hint && <p id={`${id}-hint`} class="field-hint">{hint}</p>}
  {error && <p id={`${id}-error`} class="field-error">{error}</p>}
</div>
