---
import Container from './Container.astro';
import { navigation } from '../data/navigation';
interface Props { active?: string; overlay?: boolean; }
const { active = '/aiflow/', overlay = false } = Astro.props;
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <Container class="header-inner">
    <a href="/aiflow/" class="wordmark" aria-label="广告执行部 AI 提效平台首页"><span>广告执行部</span><span>AI 提效平台</span></a>
    <nav class="desktop-nav" aria-label="主导航">{navigation.map(item => <a href={item.pending ? '#next-page' : item.href} data-destination={item.pending ? item.href : undefined} data-page-label={item.pending ? item.label : undefined} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
    <a href="/aiflow/me/help/" class="header-help">帮助与支持</a>
  </Container>
</header>
