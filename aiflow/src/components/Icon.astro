---
import film from '@phosphor-icons/core/assets/regular/film-strip.svg?raw';
import video from '@phosphor-icons/core/assets/regular/device-mobile.svg?raw';
import training from '@phosphor-icons/core/assets/regular/graduation-cap.svg?raw';
import presentation from '@phosphor-icons/core/assets/regular/presentation-chart.svg?raw';
import capture from '@phosphor-icons/core/assets/regular/device-mobile-camera.svg?raw';
import inspection from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import arrow from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import open from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import knowledge from '@phosphor-icons/core/assets/regular/books.svg?raw';
import bookmark from '@phosphor-icons/core/assets/regular/bookmark-simple.svg?raw';
import clock from '@phosphor-icons/core/assets/regular/clock.svg?raw';
import chat from '@phosphor-icons/core/assets/regular/chat-circle-text.svg?raw';
import tasks from '@phosphor-icons/core/assets/regular/clipboard-text.svg?raw';
import bell from '@phosphor-icons/core/assets/regular/bell.svg?raw';
import key from '@phosphor-icons/core/assets/regular/key.svg?raw';
import settings from '@phosphor-icons/core/assets/regular/gear.svg?raw';
import home from '@phosphor-icons/core/assets/regular/house.svg?raw';
import planning from '@phosphor-icons/core/assets/regular/flow-arrow.svg?raw';
import shield from '@phosphor-icons/core/assets/regular/shield-check.svg?raw';
import database from '@phosphor-icons/core/assets/regular/database.svg?raw';
import delivery from '@phosphor-icons/core/assets/regular/package.svg?raw';
import filter from '@phosphor-icons/core/assets/regular/sliders-horizontal.svg?raw';
import reset from '@phosphor-icons/core/assets/regular/arrow-counter-clockwise.svg?raw';
import grid from '@phosphor-icons/core/assets/regular/squares-four.svg?raw';
const icons = { filter,reset,grid,planning,shield,database,delivery,bookmark,clock,chat,tasks,bell,key,settings,home, knowledge, film, video, training, presentation, capture, inspection, arrow, open };
interface Props { name: keyof typeof icons; class?: string; }
const { name, class: className } = Astro.props;
---
<span aria-hidden="true" class:list={['icon', className]} set:html={icons[name]} />
