---
import { knowledgeEntries } from '../data/knowledge';
interface Props {section:string;}
const {section}=Astro.props;
const entry=knowledgeEntries.find(item=>item.slug===section);
---
{!section?<div class="workspace-apps">{knowledgeEntries.map(item=><article class="card catalog-card"><a class="catalog-cover" href={`/aiflow/workspace/knowledge/${item.slug}/`} aria-label={`查看${item.title}`}><img src={`/aiflow/assets/cover-knowledge-${item.slug}-bright-v1.webp`} alt="" width="800" height="450" loading="lazy"/><span class="cover-caption">功能示意</span></a><div class="catalog-top"><div class="catalog-identity"><h2><a href={`/aiflow/workspace/knowledge/${item.slug}/`}>{item.title}</a></h2><div class="platform-tags"><span>{item.type}</span></div></div><span class:list={['status-badge',item.href?'status-ready':'status-pending']}><i aria-hidden="true"></i>{item.status}</span></div><p>{item.description}</p><div class="catalog-bottom"><a href={`/aiflow/workspace/knowledge/${item.slug}/`}>查看入口 →</a></div></article>)}</div>:<><nav class="category-tabs" aria-label="知识百宝箱">{knowledgeEntries.map(item=><a href={`/aiflow/workspace/knowledge/${item.slug}/`} aria-current={section===item.slug?'page':undefined}>{item.title}</a>)}</nav>{entry&&<section class="detail-main knowledge-entry"><img class="knowledge-cover" src={`/aiflow/assets/cover-knowledge-${entry.slug}-bright-v1.webp`} alt="功能示意" width="800" height="450"/><div><span class:list={['status-badge',entry.href?'status-ready':'status-pending']}>{entry.status}</span><h2>{entry.title}</h2><p>{entry.description}</p><div class="platform-tags"><span>{entry.type}</span></div>{entry.href?<a class="button button--primary" href={entry.href} target="_blank" rel="noopener noreferrer">{entry.slug==='assistant'?'打开 AI 知识助手':'打开飞书知识库'} ↗</a>:<><p>{entry.slug==='training'?'小程序尚未上线，上线后提供打开入口。':'资料入口待补充。'}</p><button class="button" disabled>{entry.status}</button></>}</div></section>}</>}
<style>.knowledge-entry{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center}.knowledge-cover{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:8px}.knowledge-entry h2{margin:24px 0 16px}.knowledge-entry p{color:var(--color-muted);line-height:1.8}.knowledge-entry .platform-tags{margin:20px 0}.knowledge-entry .button{margin-top:16px}</style>
