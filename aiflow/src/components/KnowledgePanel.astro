---
import Icon from './Icon.astro';
interface Props {section:string;}
const {section}=Astro.props;
const entries=[{slug:'search',title:'知识检索',description:'查找业务文档、执行规范与工具说明。',icon:'knowledge' as const},{slug:'qa',title:'AI 问答',description:'围绕业务问题提问，获取带来源的解答。',icon:'inspection' as const},{slug:'training',title:'新人培训',description:'通过新人培训小程序学习业务与执行流程。',icon:'training' as const}];
---
{!section?<div class="scene-grid knowledge-grid">{entries.map(entry=><section class="card scene-card"><span class="card-symbol"><Icon name={entry.icon}/></span><h2>{entry.title}</h2><p>{entry.description}</p><a class="scene-action" href={`/workspace/knowledge/${entry.slug}/`}>进入{entry.title} <span aria-hidden="true">→</span></a></section>)}</div>:<>
<nav class="category-tabs" aria-label="知识库功能">{entries.map(entry=><a href={`/workspace/knowledge/${entry.slug}/`} aria-current={section===entry.slug?'page':undefined}>{entry.title}</a>)}</nav>
{section==='search'&&<><div class="knowledge-controls"><label for="knowledge-query">搜索知识</label><input id="knowledge-query" placeholder="输入文档名称或业务关键词" disabled/><div class="knowledge-filter"><label for="knowledge-category">分类</label><select id="knowledge-category" disabled><option>全部知识</option><option>业务规范</option><option>工具说明</option><option>培训资料</option></select><button class="button" disabled>搜索</button></div></div><section class="workspace-empty"><span class="status-badge status-pending">资料待接入</span><h2>知识检索即将开放</h2><p>资料接入后，将展示文档标题、摘要、分类与查看入口。</p></section></>}
{section==='qa'&&<section class="knowledge-qa"><span class="status-badge status-pending">AI 服务待接入</span><h2>有什么业务问题？</h2><p>接入知识源后，回答将在这里展示，并附上引用来源。</p><div class="knowledge-prompts"><span>投放上线前需要核查哪些信息？</span><span>监播 PPT 需要准备哪些材料？</span><span>新人如何了解执行流程？</span></div><label for="knowledge-question">你的问题</label><textarea id="knowledge-question" rows="4" disabled placeholder="AI 问答服务接入后可在这里提问"></textarea><button class="button" disabled>暂未开放</button></section>}
{section==='training'&&<section class="workspace-empty"><span class="card-symbol"><Icon name="training"/></span><h2>新人培训小程序</h2><div class="platform-tags"><span>小程序</span><span class="status-pending">待上线</span></div><p>通过小程序开展新人培训。当前尚未上线，上线后将在这里提供打开入口。</p><button class="button" disabled>小程序待上线</button></section>}
</>}
<style>
.knowledge-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.knowledge-grid .scene-card{padding:30px;min-height:330px}.knowledge-grid .card-symbol{margin-bottom:28px}.knowledge-grid h2{font-size:26px}.scene-card p{color:var(--color-muted);font-size:14px;line-height:1.9;margin-bottom:36px}.scene-card>.status-badge{align-self:start;margin-bottom:24px}.knowledge-controls{display:grid;gap:14px;max-width:760px;margin-bottom:40px}.knowledge-controls input,.knowledge-controls select,.knowledge-qa textarea{padding:14px 18px;background:var(--color-surface);border:1px solid var(--color-line);border-radius:5px;color:var(--color-muted)}.knowledge-filter{display:flex;align-items:center;gap:18px}.knowledge-qa{padding:40px;border:1px solid var(--color-line);border-radius:8px;background:var(--color-surface)}.knowledge-qa h2{margin:26px 0 16px;font-size:30px}.knowledge-qa p{color:var(--color-muted)}.knowledge-prompts{display:flex;flex-wrap:wrap;gap:12px;margin:32px 0}.knowledge-prompts span{font-size:13px;padding:10px 16px;border:1px solid var(--color-line);border-radius:5px;color:var(--color-muted)}.knowledge-qa label{display:block;margin-bottom:12px}.knowledge-qa textarea{display:block;width:100%;resize:none;margin-bottom:20px}
</style>
