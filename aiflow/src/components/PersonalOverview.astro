---
import { apps } from '../data/catalog';
import Icon from './Icon.astro';
---
<div class="personal-dashboard">
 <div class="personal-main-column">
  {[['favorites','我的收藏'],['recent','最近使用']].map(([kind,title])=><section class="personal-panel" data-overview-section={kind}>
   <header><h2>{title}</h2><a href={`/aiflow/me/${kind}/`}>查看全部 <span aria-hidden="true">↗</span></a></header>
   <div class="overview-list" data-overview-list={kind} hidden>{apps.map(app=><a class="overview-app" href={`/aiflow/workspace/apps/${app.id}/`} data-overview-app={app.id} hidden><span class="overview-icon"><Icon name={app.id==='ppt-v5'?'presentation':app.id==='brand-inspection'?'inspection':app.business==='short-video'?'capture':'film'}/></span><span class="overview-app__name">{app.name}<small>{app.platforms.join(' · ')||app.type}</small></span><Icon name="open"/></a>)}</div>
   <div class="overview-empty" data-overview-empty={kind}><Icon name={kind==='favorites'?'knowledge':'inspection'}/><p>{kind==='favorites'?'还没有收藏应用':'还没有使用记录'}</p><a href="/aiflow/workspace/">{kind==='favorites'?'去工作区收藏常用应用':'浏览应用'} →</a></div>
  </section>)}
  <p class="overview-footnote">收藏与使用记录仅保存在当前浏览器。</p>
 </div>
 <aside class="personal-action-column">
  <section class="personal-panel request-panel"><header><h2>AI 提需与反馈</h2></header><p>记录重复工作，提出改善需求。</p><div class="request-actions"><a class="button button--primary" href="/aiflow/me/requests/new/">提交需求</a><a class="button" href="/aiflow/me/requests/feedback/">问题反馈</a></div></section>
  <section class="personal-panel draft-panel"><header><h2>本地草稿</h2></header><div data-draft-list class="overview-drafts"></div><p class="overview-footnote">草稿尚未提交，仅保存在此浏览器。</p><div class="overview-help"><h2>帮助与共建</h2><a href="/aiflow/me/help/guides/">使用指南 <span>↗</span></a><a href="/aiflow/me/help/faq/">常见问题 <span>↗</span></a></div></section>
 </aside>
 <p class="personal-service-note"><span class="status-dot"></span>任务、通知与账号服务待接入</p>
</div>
