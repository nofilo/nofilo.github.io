---
import { businessNames, scenes, type CatalogApp } from '../data/catalog';
import Icon from './Icon.astro';
interface Props { apps: CatalogApp[]; }
const { apps } = Astro.props;
---
<div class="workspace-apps">
{apps.map(app => <article class="card catalog-card" data-app-id={app.id} data-app-card data-name={`${app.name} ${app.desc} ${app.platforms.join(" ")} ${businessNames[app.business]} ${scenes.find(([id])=>id===app.scene)?.[1]}`} data-type={app.type} data-status={app.status}>
  <div class="catalog-top"><span class="status-badge" class:list={{'status-pending':['待开发','待上线','适配待确认'].includes(app.status)}}>{app.status}</span><button class="save-app" data-favorite={app.id} aria-pressed="false" aria-label={`收藏${app.name}`}>收藏</button></div>
  <span class="card-symbol"><Icon name={app.business==='long-video'?'film':'video'} /></span>
  <div class="platform-tags">{app.platforms.map(platform=><span>{platform}</span>)}<span>{app.type}</span></div>
  <h2><a href={`/aiflow/workspace/apps/${app.id}/`}>{app.name}</a></h2><p>{app.desc}</p>
  <div class="catalog-bottom"><span>{businessNames[app.business]}</span><a href={`/aiflow/workspace/apps/${app.id}/`}>查看应用 <span aria-hidden="true">↗</span></a></div>
</article>)}
</div>
