---
import Container from '../Container.astro';
import Button from '../Button.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-picture"><img src="/assets/hero-desktop.webp" width="1672" height="941" alt="" fetchpriority="high" decoding="async" /></picture>
  <Container class="hero-content"><p class="hero-eyebrow">广告执行部 · AI 提效应用集成平台</p><h1 id="hero-title"><span class="hero-line"><span>让工具彼此连接</span></span><span class="hero-line"><span>让执行从容有序</span></span></h1><p class="hero-tagline">Your Execution Partner</p><p class="hero-description">从业务出发，找到需要的应用。</p><div class="hero-actions"><Button href="/workspace/" variant="primary" label="工作区">进入工作区</Button><Button href="/me/" label="我的">我的应用</Button></div></Container>
  <a href="#featured" class="scroll-cue" data-scroll>向下探索<span class="scroll-cue__line" aria-hidden="true"></span></a>
</section>
