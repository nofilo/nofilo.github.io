---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/Container.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WorkspaceApps from '../../components/WorkspaceApps.astro';
import { apps } from '../../data/catalog';
export function getStaticPaths(){return [undefined,'favorites','recent','requests','requests/new','requests/feedback','tasks','notifications','notifications/settings','access-requests','settings','help','help/guides','help/faq','help/changelog','help/contribute'].map(path=>({params:{path}}));}
const links=[['','我的概览'],['favorites','我的收藏'],['recent','最近使用'],['requests','AI 提需与反馈'],['tasks','我的任务'],['notifications','我的通知'],['access-requests','我的权限申请'],['settings','账号设置'],['help','帮助与共建']];
const helpLinks=[['guides','使用指南'],['faq','常见问题'],['changelog','更新日志'],['contribute','共建资源']];
const [part='',sub='']=(Astro.params.path||'').split('/');
const baseTitle=links.find(([id])=>id===part)?.[1]||'我的';
const title=part==='help'&&sub?helpLinks.find(([id])=>id===sub)?.[1]||baseTitle:part==='requests'&&sub?(sub==='new'?'提交需求':'问题反馈'):part==='notifications'&&sub?'通知设置':baseTitle;
const crumbs=[{label:'首页',href:'/aiflow/'},{label:'我的',href:'/aiflow/me/'},...(part?[{label:baseTitle,href:`/aiflow/me/${part}/`}]:[]),...(sub?[{label:title,href:undefined}]:[])];
const collection=part==='favorites'||part==='recent';
---
<SiteLayout title={title}><Container class="workspace-shell"><Breadcrumbs items={crumbs}/><header class="workspace-heading"><h1>{title}</h1></header>
<div class="personal-layout"><nav class="personal-nav" aria-label="我的功能">{links.map(([id,label])=><a href={`/aiflow/me/${id?`${id}/`:''}`} aria-current={part===id?'page':undefined}>{label}</a>)}</nav><div class="personal-content">
{!part&&<><div class="scene-grid personal-summary"><section class="card scene-card"><h2>我的收藏</h2><p><strong data-personal-count="favorites">—</strong> 个应用</p><a class="scene-action" href="/aiflow/me/favorites/">查看收藏 →</a></section><section class="card scene-card"><h2>最近使用</h2><p><strong data-personal-count="recent">—</strong> 个应用</p><a class="scene-action" href="/aiflow/me/recent/">查看记录 →</a></section></div><p class="personal-note">收藏与使用记录保存在当前浏览器。</p><div class="personal-rows"><a href="/aiflow/me/requests/"><h2>AI 提需与反馈</h2><span>进入 →</span></a><a href="/aiflow/me/help/"><h2>帮助与共建</h2><span>进入 →</span></a></div></>}
{collection&&<><p class="personal-note">{part==='recent'?'点击应用获取入口后，使用记录会保存在当前浏览器。':'与工作区的收藏同步，保存在当前浏览器。'}</p><div data-personal-collection={part} hidden><WorkspaceApps apps={apps}/></div><section class="workspace-empty" data-collection-empty><h2>{part==='favorites'?'还没有收藏应用':'还没有使用记录'}</h2><p>{part==='favorites'?'在工作区的应用卡片或详情页点击收藏。':'打开应用详情，点击获取入口后会记录在这里。'}</p><a class="button" href="/aiflow/workspace/">浏览应用</a></section><noscript><p>请启用 JavaScript 以读取此浏览器保存的记录。</p></noscript></>}
{part==='requests'&&<><nav class="category-tabs" aria-label="提需与反馈">{[['','我的提报'],['new','提交需求'],['feedback','问题反馈']].map(([id,label])=><a href={`/aiflow/me/requests/${id?`${id}/`:''}`} aria-current={sub===id?'page':undefined}>{label}</a>)}</nav>
{sub?<><p class="personal-note">服务尚未接入。可预览内容或保存为本地草稿，不会发送给负责人。</p><form class="personal-form" data-draft-form={sub}><label for="request-title">{sub==='new'?'需求标题':'问题标题'}</label><input id="request-title" name="title" maxlength="100" placeholder="用一句话描述" required/>
{sub==='feedback'?<><label for="request-app">关联应用</label><select id="request-app" name="app"><option value="">选择应用</option>{apps.map(app=><option value={app.id}>{app.name}</option>)}</select></>:<><label for="request-business">业务场景</label><select id="request-business" name="business">{['智能知识库','长视频','短视频','其他'].map(name=><option>{name}</option>)}</select></>}
<label for="request-description">{sub==='new'?'现有问题与预期结果':'问题描述'}</label><textarea id="request-description" name="description" rows="7" maxlength="5000" placeholder="描述当前的操作和需要改善的地方" required/><div class="form-actions"><button class="button button--primary" type="submit">预览提报内容</button><button class="button" type="button" data-save-draft>保存本地草稿</button></div><p class="personal-note" role="status" data-draft-status></p></form><section class="draft-preview" data-draft-preview hidden aria-labelledby="draft-preview-heading"><h2 id="draft-preview-heading">内容预览 · 未提交</h2><h3 data-preview-title></h3><p data-preview-category></p><p data-preview-description></p></section></>:<><section class="workspace-empty"><h2>尚未接入需求服务</h2><p>接通后可在这里查看提报记录与处理进度。</p><a class="button" href="/aiflow/me/requests/new/">填写需求</a></section><section class="local-drafts"><h2>本地草稿</h2><p class="personal-note">草稿不代表已提交。</p><div data-draft-list></div></section></>}
</>}
{['tasks','notifications','access-requests'].includes(part)&&<>{part==='notifications'&&!sub&&<div class="personal-toolbar"><a class="button" href="/aiflow/me/notifications/settings/">通知设置</a></div>}<section class="workspace-empty"><span class="status-badge status-pending">尚未接入</span><h2>{sub?'通知设置暂未开放':`${baseTitle}暂未开放`}</h2><p>{part==='tasks'?'接通任务服务后，将展示执行状态、日志与结果。':part==='notifications'?'接通账号与通知服务后，可查看消息并配置站内及飞书通知。':'接通权限服务后，可查看申请记录与审批进度。'}</p><a class="button" href="/aiflow/me/">返回我的</a></section></>}
{part==='settings'&&<section class="workspace-empty"><span class="status-badge status-pending">尚未接入账号</span><h2>账号设置暂未开放</h2><p>连接登录服务后，可查看和管理个人账号信息。</p><a class="button" href="/aiflow/me/">返回我的</a></section>}
{part==='help'&&!sub&&<div class="personal-rows">{helpLinks.map(([id,label])=><a href={`/aiflow/me/help/${id}/`}><h2>{label}</h2><span>查看 →</span></a>)}</div>}
{part==='help'&&sub==='guides'&&<div class="personal-prose"><section><h2>按业务找应用</h2><p>进入工作区，选择智能知识库查找知识、提问或学习；选择长视频或短视频，再选择投放搭建、上线验收、数据回收或结案交付。也可以在总览直接搜索应用名称。</p><a class="action-link" href="/aiflow/workspace/">进入工作区 →</a></section><section><h2>使用与收藏</h2><p>应用详情展示需要准备的材料、预期结果与获取入口。点击收藏后，可在“我的收藏”再次找到应用。</p></section><section><h2>提出需求</h2><p>在 AI 提需与反馈中填写需求或问题。目前支持本地草稿和预览，尚未接通正式提交服务。</p></section></div>}
{part==='help'&&sub==='faq'&&<div class="personal-faq">{[['待开发的应用能使用吗？','暂时不能。应用开放后会提供获取入口。'],['收藏会同步到其他电脑吗？','当前仅保存在此浏览器，尚未连接账号同步。'],['保存草稿算提交需求吗？','不算。草稿仅保存在当前浏览器，没有发送给负责人。'],['为什么有些应用没有下载入口？','对应工具包、配置或使用说明尚未补齐。自动监播采集可联系乔文心获取。']].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div>}
{part==='help'&&sub==='changelog'&&<div class="personal-prose"><section><p class="eyebrow">2026.10.11 · 本地预览</p><h2>工作区与个人页面</h2><p>上线本地页面预览：应用浏览、业务场景、应用详情、收藏、最近使用及需求草稿。真实登录、任务与提交服务尚未接入。</p></section></div>}
{part==='help'&&sub==='contribute'&&<section class="workspace-empty"><span class="status-badge status-pending">待整理</span><h2>共建资源</h2><p>接入规范、开发模板、可复用组件与提示词资料整理后将在这里展示。</p><a class="button" href="/aiflow/me/requests/new/">填写共建需求</a></section>}
</div></div><p class="local-feedback" role="status" data-local-feedback></p></Container><script>import '../../scripts/workspace';import '../../scripts/personal';</script></SiteLayout>
